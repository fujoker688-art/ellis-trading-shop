# Security Headers — ellis-trading.shop
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src https://www.speedmalls.com data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-XSS-Protection: 1; mode=block

# HTML — no cache (so updates are visible immediately)
*.html
  Cache-Control: no-cache, must-revalidate

# JS & CSS — short cache during development
css/*.css
  Cache-Control: max-age=86400
js/*.js
  Cache-Control: max-age=86400

# Images — longer cache
images/*
  Cache-Control: max-age=2592000

# XML
*.xml
  Cache-Control: no-cache
